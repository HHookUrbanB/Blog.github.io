<!-- Hero Section -->
<header class="hero">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title"><%= config.title %></h1>
            <p class="hero-subtitle"><%= config.description %></p>
            <div class="hero-tags">
                <span class="tag">网络安全</span>
                <span class="tag">Python</span>
                <span class="tag">NBA</span>
                <span class="tag">工具技术</span>
            </div>
            <div class="hero-cta">
                <a href="/archives/" class="btn btn-primary">阅读文章</a>
                <a href="/about/" class="btn btn-secondary">了解更多</a>
            </div>
        </div>
    </div>
</header>

<!-- 精选文章 -->
<section class="section">
    <div class="container">
        <h2 class="section-title">最新文章</h2>
        <div class="posts-grid">
            <% site.posts.sort('date', -1).limit(3).each(function(post) { %>
                <article class="post-card">
                    <div class="post-card-content">
                        <div class="post-meta">
                            <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>">
                                <%= date(post.date, 'YYYY-MM-DD') %>
                            </time>
                            <% if (post.categories && post.categories.length) { %>
                                <span class="post-category">
                                    <%= post.categories.first().name %>
                                </span>
                            <% } %>
                        </div>
                        <h3 class="post-title">
                            <a href="<%= url_for(post.path) %>"><%= post.title %></a>
                        </h3>
                        <p class="post-excerpt">
                            <%= strip_html(post.excerpt || post.content).substring(0, 150) %>...
                        </p>
                        <a href="<%= url_for(post.path) %>" class="read-more">阅读全文 →</a>
                    </div>
                </article>
            <% }) %>
        </div>
        <div class="section-cta">
            <a href="/archives/" class="btn btn-outline">查看所有文章</a>
        </div>
    </div>
</section>

<!-- 分类展示 -->
<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">内容分类</h2>
        <div class="categories-grid">
            <% 
            var categories = [
                {name: 'NBA', icon: '🏀', desc: '篮球新闻与分析'},
                {name: '知识学习', icon: '📖', desc: '学习新知识、新概念'},
                {name: '工具技术', icon: '🛠️', desc: '学习新工具、新技术'},
                {name: '生活日常', icon: '📝', desc: '生活记录与随笔'}
            ];
            %>
            <% categories.forEach(function(cat) { %>
                <% var catData = site.categories.findOne({name: cat.name}); %>
                <a href="/categories/<%= cat.name %>/" class="category-card">
                    <div class="category-icon"><%= cat.icon %></div>
                    <h3><%= cat.name %></h3>
                    <p><%= cat.desc %></p>
                    <% if (catData) { %>
                        <span class="category-count"><%= catData.length %> 篇</span>
                    <% } %>
                </a>
            <% }) %>
        </div>
    </div>
</section>
