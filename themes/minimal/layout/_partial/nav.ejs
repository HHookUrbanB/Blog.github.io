<nav class="nav" id="nav">
    <div class="nav-container">
        <a href="/" class="nav-logo"><%= config.title %></a>
        
        <div class="nav-menu" id="nav-menu">
            <% for (var i in theme.menu) { %>
                <a href="<%= url_for(theme.menu[i]) %>" 
                   class="nav-link <%= is_current(theme.menu[i]) ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>
        </div>
        
        <div class="nav-social">
            <% if (theme.social.GitHub) { %>
                <a href="<%= theme.social.GitHub %>" target="_blank" class="social-icon" title="GitHub">
                    <i class="fab fa-github"></i>
                </a>
            <% } %>
            <% if (theme.social.Email) { %>
                <a href="<%= theme.social.Email %>" class="social-icon" title="Email">
                    <i class="fas fa-envelope"></i>
                </a>
            <% } %>
        </div>
        
        <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>
</nav>
